<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ run.project_name }} | {{ run.run_id }}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #eef3f5;
        --card: #ffffff;
        --ink: #152432;
        --muted: #607382;
        --line: #d8e3ea;
        --accent: #0f766e;
        --accent-soft: #d7efe9;
        --danger-soft: #fff1eb;
        --shadow: 0 24px 60px rgba(15, 23, 42, 0.09);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(144, 205, 244, 0.24), transparent 32%),
          radial-gradient(circle at top right, rgba(15, 118, 110, 0.14), transparent 24%),
          var(--bg);
        color: var(--ink);
        font: 15px/1.55 "Aptos", "Trebuchet MS", sans-serif;
      }
      main {
        max-width: 1240px;
        margin: 0 auto;
        padding: 28px 22px 48px;
      }
      .hero {
        background: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(255, 255, 255, 0.94));
        border: 1px solid rgba(15, 118, 110, 0.14);
        border-radius: 28px;
        box-shadow: var(--shadow);
        padding: 30px;
        margin-bottom: 22px;
      }
      .eyebrow {
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      h1, h2, h3 {
        font-family: Georgia, "Times New Roman", serif;
        margin: 0 0 10px;
      }
      h1 {
        font-size: clamp(28px, 5vw, 42px);
      }
      h2 {
        font-size: 24px;
        margin-bottom: 14px;
      }
      h3 {
        font-size: 19px;
      }
      p {
        margin: 0;
      }
      .subtitle {
        color: var(--muted);
        max-width: 820px;
      }
      .grid {
        display: grid;
        gap: 18px;
      }
      .grid-4 {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .grid-2 {
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      }
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: var(--shadow);
        padding: 22px;
      }
      .metric-value {
        font-size: 28px;
        font-weight: 700;
        margin-top: 10px;
      }
      .metric-note {
        color: var(--muted);
        font-size: 13px;
      }
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 700;
      }
      .status-pill.failed {
        background: var(--danger-soft);
        color: #b45309;
      }
      .status-pill.dry_run {
        background: #eef2ff;
        color: #4338ca;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }
      th {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .mono {
        font-family: Consolas, "Courier New", monospace;
        font-size: 13px;
      }
      .section {
        margin-top: 20px;
      }
      .soft {
        color: var(--muted);
      }
      .heatmap td {
        text-align: center;
        font-weight: 700;
      }
      .codebox {
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 18px;
        padding: 16px;
        overflow: auto;
      }
      .delta-positive {
        color: #b45309;
        font-weight: 700;
      }
      .delta-negative {
        color: #0f766e;
        font-weight: 700;
      }
      .delta-neutral {
        color: var(--ink);
        font-weight: 700;
      }
      .stack {
        display: grid;
        gap: 14px;
      }
      .small {
        font-size: 13px;
      }
      .history-svg svg {
        width: 100%;
        height: auto;
      }
      @media (max-width: 720px) {
        main {
          padding: 18px 14px 34px;
        }
        .hero,
        .card {
          border-radius: 20px;
          padding: 18px;
        }
        th, td {
          padding: 10px 8px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="eyebrow">MSC Nastran FEM Automation</div>
        <h1>{{ run.project_name }}</h1>
        <p class="subtitle">
          Corrida <span class="mono">{{ run.run_id }}</span> ejecutada con el comando
          <span class="mono">{{ run.command }}</span>. Este reporte resume la trazabilidad del BDF generado,
          la ejecución de Nastran, el parseo modal y las métricas MAC para los 10 primeros modos.
        </p>
      </section>

      <section class="grid grid-4">
        <article class="card">
          <div class="metric-note">Estado</div>
          <div class="metric-value">
            <span class="status-pill {{ run.status }}">{{ run.status }}</span>
          </div>
          <div class="metric-note">Generado en {{ run.created_at }}</div>
        </article>
        <article class="card">
          <div class="metric-note">Masa total</div>
          <div class="metric-value">{{ "%.6f"|format(run.mass.total_mass) }} kg</div>
          <div class="metric-note">
            Objetivo: {{ "%.6f"|format(run.mass.target_mass) }} kg |
            Error relativo: {{ "%.4f"|format(run.mass.relative_error * 100) }}%
          </div>
          <div class="metric-note">
            Metodo: {{ run.mass.method }}
            {% if run.mass.budget_comparison %}
              | Budget {{ run.mass.budget_comparison.basis|upper }}:
              {{ "%.6f"|format(run.mass.budget_comparison.budget_total_mass) }} kg |
              Delta: {{ "%+.6f"|format(run.mass.budget_comparison.delta_mass) }} kg
            {% endif %}
          </div>
        </article>
        <article class="card">
          <div class="metric-note">Score global</div>
          <div class="metric-value">
            {% if run.modal_metrics %}
              {{ "%.6f"|format(run.modal_metrics.score) }}
            {% else %}
              n/a
            {% endif %}
          </div>
          <div class="metric-note">
            Modo de score:
            {% if run.modal_metrics %}{{ run.modal_metrics.score_mode }}{% else %}sin comparar{% endif %}
          </div>
        </article>
        <article class="card">
          <div class="metric-note">Mean / Worst MAC</div>
          <div class="metric-value">
            {% if run.modal_metrics %}
              {{ "%.4f"|format(run.modal_metrics.mean_mac) }} / {{ "%.4f"|format(run.modal_metrics.worst_mac) }}
            {% else %}
              n/a
            {% endif %}
          </div>
          <div class="metric-note">
            Error medio de frecuencia:
            {% if run.modal_metrics %}
              {{ "%.4f"|format(run.modal_metrics.mean_relative_frequency_error * 100) }}%
            {% else %}
              n/a
            {% endif %}
          </div>
        </article>
        <article class="card">
          <div class="metric-note">Stiffness Fit Indicator</div>
          <div class="metric-value">
            {% if run.modal_metrics %}
              {{ "%.4f"|format(run.modal_metrics.stiffness_fit_indicator * 100) }}%
            {% else %}
              n/a
            {% endif %}
          </div>
          <div class="metric-note">
            Para seguir cambios de E. Menor es mejor.
            {% if run.modal_metrics %}
              Formula: freq medio + 0.10 * (1 - mean MAC)
            {% endif %}
          </div>
        </article>
      </section>

      <section class="grid grid-2 section">
        <article class="card stack">
          <div>
            <h2>Resumen Ejecutivo</h2>
            <p class="soft">
              El flujo preserva el BDF original, genera una carpeta de corrida propia y registra tanto
              la edición de materiales como la ejecución de Nastran y el postproceso modal.
            </p>
          </div>
          <div>
            <h3>Parámetros usados</h3>
            <table>
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Grupo</th>
                  <th>Campo</th>
                  <th>Valor</th>
                </tr>
              </thead>
              <tbody>
                {% for row in run.parameter_rows %}
                <tr>
                  <td class="mono">{{ row.name }}</td>
                  <td>{{ row.group }}</td>
                  <td>{{ row.target }}</td>
                  <td>{{ "%.6f"|format(row.value) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <div>
            <h3>Mejor corrida destacada</h3>
            <p class="soft">
              En esta iteración solo hay una corrida efectiva por configuración. El reporte queda preparado
              para que la fase 2 resalte automáticamente la mejor combinación tras el barrido.
            </p>
          </div>
        </article>

        <article class="card stack">
          <div>
            <h2>Evolución del Score</h2>
            <div class="history-svg">{{ score_history_svg | safe }}</div>
          </div>
          <div>
            <h3>Tabla de corridas</h3>
            <table>
              <thead>
                <tr>
                  <th>Run ID</th>
                  <th>Estado</th>
                  <th>Score</th>
                  <th>Mean MAC</th>
                </tr>
              </thead>
              <tbody>
                {% for item in history %}
                <tr>
                  <td class="mono">{{ item.run_id }}</td>
                  <td>{{ item.status }}</td>
                  <td>{{ "%.6f"|format(item.score) }}</td>
                  <td>{% if item.mean_mac is not none %}{{ "%.4f"|format(item.mean_mac) }}{% else %}n/a{% endif %}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </article>
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Edición del BDF</h2>
          <p class="soft small">
            Solo se han editado tarjetas MAT1 para densidad y módulo de Young. El BDF original no se toca.
          </p>
          <table>
            <thead>
              <tr>
                <th>MAT1</th>
                <th>Campo</th>
                <th>Original</th>
                <th>Nuevo</th>
                <th>Factor</th>
              </tr>
            </thead>
            <tbody>
              {% for item in run.modifications %}
              <tr>
                <td>{{ item.mat1_id }}</td>
                <td>{{ item.field_name }}</td>
                <td>{{ "%.6e"|format(item.original_value) }}</td>
                <td>{{ "%.6e"|format(item.new_value) }}</td>
                <td>{{ "%.6f"|format(item.factor_applied) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </article>

        <article class="card">
          <h2>Archivos Generados</h2>
          <table>
            <thead>
              <tr>
                <th>Ruta relativa</th>
              </tr>
            </thead>
            <tbody>
              {% for path in run.generated_files %}
              <tr>
                <td class="mono">{{ path }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </article>
      </section>

      <section class="card section">
        <h2>Mass Budget</h2>
        {% if run.mass.budget_comparison %}
          <p class="soft small">
            Comparacion automatica contra
            <span class="mono">{{ run.mass.budget_comparison.workbook }}</span>,
            hoja <span class="mono">{{ run.mass.budget_comparison.sheet }}</span>,
            usando la columna <span class="mono">{{ run.mass.budget_comparison.basis }}</span>.
          </p>
          <table>
            <thead>
              <tr>
                <th>Categoria</th>
                <th>Budget [kg]</th>
                <th>Modelo [kg]</th>
                <th>Delta [kg]</th>
                <th>Delta [%]</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run.mass.budget_comparison.rows %}
              {% set delta_class = "delta-neutral" %}
              {% if row.delta_mass > 0 %}
                {% set delta_class = "delta-positive" %}
              {% elif row.delta_mass < 0 %}
                {% set delta_class = "delta-negative" %}
              {% endif %}
              <tr>
                <td>{{ row.category }}</td>
                <td>{{ "%.6f"|format(row.budget_mass) }}</td>
                <td>{{ "%.6f"|format(row.model_mass) }}</td>
                <td class="{{ delta_class }}">{{ "%+.6f"|format(row.delta_mass) }}</td>
                <td class="{{ delta_class }}">
                  {% if row.relative_delta is not none %}
                    {{ "%+.3f"|format(row.relative_delta * 100) }}
                  {% else %}
                    n/a
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="soft">
            No hay una configuracion de mass budget asociada a esta corrida.
          </p>
        {% endif %}
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Clasificacion FEM -&gt; Budget</h2>
          {% if run.mass.budget_comparison %}
            <table>
              <thead>
                <tr>
                  <th>Region FEM</th>
                  <th>Asignado a</th>
                  <th>Regla</th>
                  <th>Masa [kg]</th>
                </tr>
              </thead>
              <tbody>
                {% for row in run.mass.budget_comparison.classification_rows %}
                <tr>
                  <td class="mono">{{ row.region_name }}</td>
                  <td>{{ row.assigned_to }}</td>
                  <td>{{ row.assignment_rule }}</td>
                  <td>{{ "%.6f"|format(row.mass) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}
            <p class="soft">Sin clasificacion de masa disponible en esta corrida.</p>
          {% endif %}
        </article>

        <article class="card stack">
          <div>
            <h2>Notas de Masa</h2>
            <table>
              <thead>
                <tr>
                  <th>Concepto</th>
                  <th>Valor</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Metodo de calculo</td>
                  <td>{{ run.mass.method }}</td>
                </tr>
                <tr>
                  <td>Masa objetivo para score</td>
                  <td>{{ "%.6f"|format(run.mass.target_mass) }} kg</td>
                </tr>
                {% if run.mass.budget_comparison %}
                <tr>
                  <td>Masa budget total</td>
                  <td>{{ "%.6f"|format(run.mass.budget_comparison.budget_total_mass) }} kg</td>
                </tr>
                <tr>
                  <td>Delta global vs budget</td>
                  <td>{{ "%+.6f"|format(run.mass.budget_comparison.delta_mass) }} kg</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          {% if run.mass.budget_comparison %}
          <div>
            <h3>Criterio de reparto</h3>
            <table>
              <thead>
                <tr>
                  <th>Nota</th>
                </tr>
              </thead>
              <tbody>
                {% for note in run.mass.budget_comparison.notes %}
                <tr>
                  <td>{{ note }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% endif %}
        </article>
      </section>

      <section class="card section">
        <h2>Comparación Modal</h2>
        {% if run.modal_metrics %}
          <table>
            <thead>
              <tr>
                <th>Modo ref</th>
                <th>Modo modelo</th>
                <th>f ref [Hz]</th>
                <th>f modelo [Hz]</th>
                <th>Error [%]</th>
                <th>MAC pareado</th>
                <th>MAC diagonal i-i</th>
              </tr>
            </thead>
            <tbody>
              {% for row in frequency_rows %}
              <tr>
                <td>{{ row.reference_mode }}</td>
                <td>{{ row.model_mode }}</td>
                <td>{{ row.reference_frequency_hz }}</td>
                <td>{{ row.model_frequency_hz }}</td>
                <td>{{ row.relative_frequency_error_pct }}</td>
                <td>{{ row.paired_mac }}</td>
                <td>{{ row.diagonal_mac }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="soft">
            No hay métricas modales completas para esta corrida. Revisa la sección de logs y errores.
          </p>
        {% endif %}
      </section>

      <section class="card section">
        <h2>Heatmap MAC 10x10</h2>
        {% if run.modal_metrics %}
          <table class="heatmap">
            <thead>
              <tr>
                <th>Ref \ Modelo</th>
                {% for idx in range(1, 11) %}
                <th>{{ idx }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in heatmap_rows %}
              <tr>
                <th>{{ row.reference_mode }}</th>
                {% for cell in row.cells %}
                <td style="{{ cell.style }}">{{ cell.value }}</td>
                {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="soft">Sin matriz MAC disponible en esta corrida.</p>
        {% endif %}
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Logs y Errores</h2>
          <table>
            <thead>
              <tr>
                <th>Recurso</th>
                <th>Ruta</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>stdout</td>
                <td class="mono">{{ run.nastran.stdout_path }}</td>
              </tr>
              <tr>
                <td>stderr</td>
                <td class="mono">{{ run.nastran.stderr_path }}</td>
              </tr>
              {% for extension, path in run.nastran.outputs.items() %}
              <tr>
                <td>{{ extension }}</td>
                <td class="mono">{{ path }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if run.errors %}
          <div class="codebox section">
            {% for error in run.errors %}
{{ error }}
            {% endfor %}
          </div>
          {% endif %}
        </article>

        <article class="card">
          <h2>Rutas de Referencia</h2>
          <table>
            <thead>
              <tr>
                <th>Entrada</th>
                <th>Ruta</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>BDF base</td>
                <td class="mono">{{ run.source_bdf }}</td>
              </tr>
              <tr>
                <td>BDF generado</td>
                <td class="mono">{{ run.generated_bdf }}</td>
              </tr>
              <tr>
                <td>F06 frecuencias ref</td>
                <td class="mono">{{ run.reference_frequencies_f06 }}</td>
              </tr>
              <tr>
                <td>F06 autovectores ref</td>
                <td class="mono">{{ run.reference_vectors_f06 }}</td>
              </tr>
              <tr>
                <td>Snapshot config</td>
                <td class="mono">{{ run.config_snapshot_dir }}</td>
              </tr>
            </tbody>
          </table>
        </article>
      </section>
    </main>
  </body>
</html>
