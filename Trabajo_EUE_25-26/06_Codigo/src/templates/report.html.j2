<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ run.project_name }} | {{ run.run_id }}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #edf4f5;
        --card: #ffffff;
        --ink: #152432;
        --muted: #607382;
        --line: #d8e3ea;
        --accent: #0f766e;
        --warn: #b45309;
        --danger: #b91c1c;
        --soft: #e2f2ef;
        --shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(15, 118, 110, 0.12), transparent 28%),
          radial-gradient(circle at top right, rgba(14, 116, 144, 0.10), transparent 22%),
          var(--bg);
        color: var(--ink);
        font: 15px/1.5 "Aptos", "Trebuchet MS", sans-serif;
      }
      main {
        max-width: 1320px;
        margin: 0 auto;
        padding: 24px 18px 40px;
      }
      .hero, .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }
      .hero {
        padding: 28px;
        margin-bottom: 18px;
      }
      .eyebrow {
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      h1, h2, h3 {
        font-family: Georgia, "Times New Roman", serif;
        margin: 0 0 10px;
      }
      h1 { font-size: clamp(30px, 5vw, 42px); }
      h2 { font-size: 24px; }
      h3 { font-size: 18px; }
      .subtitle { color: var(--muted); max-width: 860px; }
      .grid { display: grid; gap: 16px; }
      .grid-4 { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
      .grid-2 { grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); }
      .card { padding: 20px; }
      .section { margin-top: 18px; }
      .metric-note { color: var(--muted); font-size: 13px; }
      .metric-value { font-size: 28px; font-weight: 700; margin-top: 8px; }
      .pill {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 700;
      }
      .pill.success, .pill.true { background: #d1fae5; color: #065f46; }
      .pill.false, .pill.failed, .pill.rejected { background: #fee2e2; color: var(--danger); }
      .pill.dry_run { background: #e0e7ff; color: #4338ca; }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th, td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }
      th {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .mono { font-family: Consolas, "Courier New", monospace; font-size: 13px; }
      .small { font-size: 13px; color: var(--muted); }
      .heatmap td { text-align: center; font-weight: 700; }
      .list {
        margin: 0;
        padding-left: 18px;
      }
      .warning { color: var(--warn); font-weight: 700; }
      .danger { color: var(--danger); font-weight: 700; }
      .soft { color: var(--muted); }
      details.fold {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #f8fbfc;
        overflow: hidden;
      }
      details.fold summary {
        cursor: pointer;
        list-style: none;
        padding: 14px 16px;
        font-weight: 700;
        color: var(--ink);
      }
      details.fold summary::-webkit-details-marker { display: none; }
      details.fold[open] summary {
        border-bottom: 1px solid var(--line);
        background: #eef6f7;
      }
      .fold-body { padding: 12px 0 0; }
      @media (max-width: 760px) {
        main { padding: 16px 12px 28px; }
        .hero, .card { border-radius: 18px; padding: 16px; }
        th, td { padding: 8px 6px; }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="eyebrow">MSC Nastran FEM Automation</div>
        <h1>{{ run.project_name }}</h1>
        <p class="subtitle">
          Corrida <span class="mono">{{ run.run_id }}</span> ejecutada con
          <span class="mono">{{ run.command }}</span>{% if run.sweep_preset %} dentro del preset
          <span class="mono">{{ run.sweep_preset }}</span>{% endif %}. El flujo se ha mantenido 100% CLI:
          edici&oacute;n MAT1, ejecuci&oacute;n de Nastran, parser F06, MAC 10x10, pairing Hungarian y auditor&iacute;a FEM.
        </p>
        <p class="subtitle">
          Target de masa usado:
          <span class="mono">{{ (run.mass.target_basis or "unknown")|upper }}</span>.
          Estado del baseline:
          <span class="mono">{{ run.mass.baseline_status or "unknown" }}</span>.
        </p>
      </section>

      <section class="grid grid-4">
        <article class="card">
          <div class="metric-note">Estado de ejecuci&oacute;n</div>
          <div class="metric-value"><span class="pill {{ run.status }}">{{ run.status }}</span></div>
          <div class="metric-note">Generado en {{ run.created_at }}</div>
        </article>
        <article class="card">
          <div class="metric-note">Aceptaci&oacute;n modal</div>
          <div class="metric-value">
            <span class="pill {{ run.accepted }}">{{ "accepted" if run.accepted else "rejected" }}</span>
          </div>
          <div class="metric-note">Ranking: {{ run.modal_metrics.selected_ranking_mode if run.modal_metrics else "n/a" }}</div>
        </article>
        <article class="card">
          <div class="metric-note">Score robust / legacy</div>
          <div class="metric-value">{{ run.score_robust_display }} / {{ run.score_legacy_display }}</div>
          <div class="metric-note">Mean MAC: {{ run.mean_mac_display }}</div>
        </article>
        <article class="card">
          <div class="metric-note">Validaci&oacute;n modal</div>
          <div class="metric-value">
            {{ run.paired_valid_mode_count }}/{{ run.valid_model_mode_count }}/{{ run.valid_reference_mode_count }}
          </div>
          <div class="metric-note">paired/model/reference valid mode count</div>
        </article>
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Resumen Ejecutivo</h2>
          <table>
            <tbody>
              <tr>
                <td>Accepted</td>
                <td>{{ run.accepted }}</td>
              </tr>
              <tr>
                <td>Reject reasons</td>
                <td>
                  {% if run.reject_reasons %}
                    <ul class="list">
                      {% for reason in run.reject_reasons %}
                      <li class="mono">{{ reason }}</li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    none
                  {% endif %}
                </td>
              </tr>
              <tr>
                <td>Mean MAC</td>
                <td>{% if run.modal_metrics and run.modal_metrics.mean_mac is not none %}{{ "%.4f"|format(run.modal_metrics.mean_mac) }}{% else %}n/a{% endif %}</td>
              </tr>
              <tr>
                <td>Worst MAC</td>
                <td>{% if run.modal_metrics and run.modal_metrics.worst_mac is not none %}{{ "%.4f"|format(run.modal_metrics.worst_mac) }}{% else %}n/a{% endif %}</td>
              </tr>
              <tr>
                <td>Mean / max relative frequency error</td>
                <td>
                  {% if run.modal_metrics and run.modal_metrics.mean_relative_frequency_error is not none %}
                    {{ "%.4f"|format(run.modal_metrics.mean_relative_frequency_error) }} /
                    {{ "%.4f"|format(run.modal_metrics.max_relative_frequency_error) }}
                  {% else %}
                    n/a
                  {% endif %}
                </td>
              </tr>
              <tr>
                <td>Bad / warning pair count</td>
                <td>{% if run.modal_metrics %}{{ run.modal_metrics.bad_pair_count }} / {{ run.modal_metrics.warning_pair_count }}{% else %}n/a{% endif %}</td>
              </tr>
            </tbody>
          </table>
        </article>

        <article class="card">
          <h2>Par&aacute;metros de la Run</h2>
          <table>
            <thead>
              <tr>
                <th>Par&aacute;metro</th>
                <th>Grupo</th>
                <th>Campo</th>
                <th>Valor</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run.parameter_rows %}
              <tr>
                <td class="mono">{{ row.name }}</td>
                <td>{{ row.group }}</td>
                <td>{{ row.target }}</td>
                <td>{{ "%.6f"|format(row.value) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </article>
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Masa Total y Ledger</h2>
          <table>
            <tbody>
              <tr>
                <td>Masa total calculada</td>
                <td>{{ "%.6f"|format(run.mass.total_mass) }} kg</td>
              </tr>
              <tr>
                <td>Masa objetivo</td>
                <td>{{ "%.6f"|format(run.mass.target_mass) }} kg</td>
              </tr>
              <tr>
                <td>Mass budget target</td>
                <td>{{ (run.mass.target_basis or "unknown")|upper }}</td>
              </tr>
              <tr>
                <td>Baseline status</td>
                <td>{{ run.mass.baseline_status or "unknown" }}</td>
              </tr>
              <tr>
                <td>Error relativo total</td>
                <td>{{ "%.4f"|format(run.mass.relative_error * 100) }}%</td>
              </tr>
              <tr>
                <td>Masa mapeada</td>
                <td>{{ "%.6f"|format(run.mass.ledgers.mapped_mass) }} kg</td>
              </tr>
              <tr>
                <td>Masa no mapeada</td>
                <td>{{ "%.6f"|format(run.mass.ledgers.unmapped_mass) }} kg</td>
              </tr>
              <tr>
                <td>Masa extra no soportada</td>
                <td>{{ "%.6f"|format(run.mass.ledgers.unsupported_extra_mass) }} kg</td>
              </tr>
            </tbody>
          </table>
          {% if run.mass.warnings %}
          <h3 class="section">Warnings de masa</h3>
          <ul class="list">
            {% for warning in run.mass.warnings %}
            <li class="mono warning">{{ warning }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </article>

        <article class="card">
          <h2>Relaci&oacute;n con el Mass Budget</h2>
          <p class="small">
            Comparaci&oacute;n directa entre el objetivo del budget
            <span class="mono">{{ (run.mass.target_basis or "unknown")|upper }}</span>
            y la masa FEM calculada en esta run.
          </p>
          <table>
            <thead>
              <tr>
                <th>Categor&iacute;a</th>
                <th>Target [kg]</th>
                <th>Computed [kg]</th>
                <th>Delta [kg]</th>
                <th>Delta [%]</th>
              </tr>
            </thead>
            <tbody>
              {% for row in mass_budget_rows %}
              <tr>
                <td>{{ row.label }}</td>
                <td>{{ "%.6f"|format(row.target_mass) }}</td>
                <td>{{ "%.6f"|format(row.computed_mass) }}</td>
                <td>{{ "%+.6f"|format(row.delta_mass) }}</td>
                <td>{% if row.relative_delta is not none %}{{ "%+.3f"|format(row.relative_delta * 100) }}{% else %}n/a{% endif %}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if mass_budget_notes %}
          <h3 class="section">Notas</h3>
          <ul class="list">
            {% for note in mass_budget_notes %}
            <li>{{ note }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </article>
      </section>

      {% if run.mass.budget_imputation_rows %}
      <section class="grid grid-2 section">
        <article class="card">
          <h2>Imputaci&oacute;n Funcional al Mass Budget</h2>
          <p class="small">
            Capa expl&iacute;cita de imputaci&oacute;n FEM -&gt; budget usando familias intermedias y reglas trazables
            desde configuraci&oacute;n.
          </p>
          <table>
            <thead>
              <tr>
                <th>Categor&iacute;a budget</th>
                <th>Target [kg]</th>
                <th>Imputed [kg]</th>
                <th>Delta [kg]</th>
                <th>Delta [%]</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run.mass.budget_imputation_rows %}
              <tr>
                <td>{{ row.label }}</td>
                <td>{{ "%.6f"|format(row.target_mass) }}</td>
                <td>{{ "%.6f"|format(row.imputed_mass) }}</td>
                <td>{{ "%+.6f"|format(row.delta_mass) }}</td>
                <td>{% if row.relative_delta is not none %}{{ "%+.3f"|format(row.relative_delta * 100) }}{% else %}n/a{% endif %}</td>
              </tr>
              {% endfor %}
              <tr>
                <td>Residual after imputation</td>
                <td>n/a</td>
                <td>{{ "%.6f"|format(run.mass.imputation_residual_mass) }}</td>
                <td>n/a</td>
                <td>n/a</td>
              </tr>
            </tbody>
          </table>
        </article>

        <article class="card">
          <h2>Familias F&iacute;sicas FEM</h2>
          <table>
            <thead>
              <tr>
                <th>Familia</th>
                <th>Contribuciones</th>
                <th>Masa [kg]</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run.mass.family_rows %}
              <tr>
                <td>{{ row.label }}</td>
                <td>{{ row.contribution_count }}</td>
                <td>{{ "%.6f"|format(row.computed_mass) }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </article>
      </section>
      {% endif %}

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Masa No Mapeada</h2>
          {% if run.mass.unmapped_rows %}
          <details class="fold">
            <summary>
              Ver masa no mapeada:
              {{ run.mass.unmapped_rows|length }} contribuciones,
              {{ "%.6f"|format(run.mass.ledgers.unmapped_mass) }} kg
            </summary>
            <div class="fold-body">
              <table>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Regi&oacute;n</th>
                    <th>PID</th>
                    <th>MID</th>
                    <th>Masa [kg]</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in run.mass.unmapped_rows %}
                  <tr>
                    <td class="mono">{{ row.contribution_id }}</td>
                    <td>{{ row.element_type }}</td>
                    <td class="mono">{{ row.region_name }}</td>
                    <td>{{ row.property_id if row.property_id is not none else "n/a" }}</td>
                    <td>{{ row.material_id if row.material_id is not none else "n/a" }}</td>
                    <td>{{ "%.6f"|format(row.mass) }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>
          {% else %}
          <p class="soft">No hay contribuciones estructurales o concentradas sin subset.</p>
          {% endif %}
        </article>

        <article class="card">
          <h2>Masa Extra No Soportada</h2>
          {% if run.mass.unsupported_extra_mass_rows %}
          <table>
            <thead>
              <tr>
                <th>Fuente</th>
                <th>ID</th>
                <th>Masa parseada</th>
                <th>Raw</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run.mass.unsupported_extra_mass_rows %}
              <tr>
                <td>{{ row.source }}</td>
                <td class="mono">{{ row.identifier }}</td>
                <td>{% if row.parsed_mass is not none %}{{ "%.6f"|format(row.parsed_mass) }}{% else %}n/a{% endif %}</td>
                <td class="mono">{{ row.raw_line }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% else %}
          <p class="soft">No se han detectado tarjetas extra no soportadas.</p>
          {% endif %}
        </article>
      </section>

      <section class="card section">
        <h2>Frecuencias, Pairing y Calidad Modal</h2>
        <table>
          <thead>
            <tr>
              <th>Modo ref</th>
              <th>Modo modelo</th>
              <th>f ref [Hz]</th>
              <th>f modelo [Hz]</th>
              <th>Error rel</th>
              <th>MAC</th>
              <th>Bad</th>
              <th>Warning</th>
              <th>Outside gate</th>
              <th>Suspicious</th>
            </tr>
          </thead>
          <tbody>
            {% for row in mode_rows %}
            <tr>
              <td>{{ row.reference_mode }}</td>
              <td>{{ row.model_mode if row.model_mode is not none else "unpaired" }}</td>
              <td>{% if row.reference_frequency_hz is not none %}{{ "%.4f"|format(row.reference_frequency_hz) }}{% else %}n/a{% endif %}</td>
              <td>{% if row.model_frequency_hz is not none %}{{ "%.4f"|format(row.model_frequency_hz) }}{% else %}n/a{% endif %}</td>
              <td>{% if row.relative_frequency_error is not none %}{{ "%.4f"|format(row.relative_frequency_error) }}{% else %}n/a{% endif %}</td>
              <td>{% if row.mac is not none %}{{ "%.4f"|format(row.mac) }}{% else %}n/a{% endif %}</td>
              <td>{{ row.bad_pair }}</td>
              <td>{{ row.warning_pair }}</td>
              <td>{{ row.outside_gate }}</td>
              <td>
                {{ row.suspicious }}
                {% if row.reference_family_label or row.model_family_label %}
                <div class="small">{{ row.reference_family_label or "n/a" }} -> {{ row.model_family_label or "n/a" }}</div>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card section">
        <h2>Heatmap MAC 10x10</h2>
        <table class="heatmap">
          <thead>
            <tr>
              <th>Ref \ Modelo</th>
              {% for idx in range(1, 11) %}
              <th>{{ idx }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in mac_heatmap_rows %}
            <tr>
              <th>{{ row.reference_mode }}</th>
              {% for cell in row.cells %}
              <td style="{{ cell.style }}">{{ cell.value }}</td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card section">
        <h2>Heatmap Error Relativo de Frecuencia 10x10</h2>
        <table class="heatmap">
          <thead>
            <tr>
              <th>Ref \ Modelo</th>
              {% for idx in range(1, 11) %}
              <th>{{ idx }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in frequency_error_heatmap_rows %}
            <tr>
              <th>{{ row.reference_mode }}</th>
              {% for cell in row.cells %}
              <td style="{{ cell.style }}">{{ cell.value }}</td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card section">
        <h2>Matriz de Pares Permitidos</h2>
        <table class="heatmap">
          <thead>
            <tr>
              <th>Ref \ Modelo</th>
              {% for idx in range(1, 11) %}
              <th>{{ idx }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in allowed_pairs_heatmap_rows %}
            <tr>
              <th>{{ row.reference_mode }}</th>
              {% for cell in row.cells %}
              <td style="{{ cell.style }}">{{ cell.value }}</td>
              {% endfor %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="grid grid-2 section">
        <article class="card">
          <h2>Warnings y Errores</h2>
          {% if run.warnings %}
          <h3>Warnings</h3>
          <ul class="list">
            {% for warning in run.warnings %}
            <li class="mono warning">{{ warning }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if run.errors %}
          <h3>Errores</h3>
          <ul class="list">
            {% for error in run.errors %}
            <li class="mono danger">{{ error }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if not run.warnings and not run.errors %}
          <p class="soft">No se han registrado warnings ni errores adicionales.</p>
          {% endif %}
        </article>

        <article class="card">
          <h2>Trazabilidad</h2>
          <table>
            <tbody>
              <tr>
                <td>BDF base</td>
                <td class="mono">{{ run.source_bdf }}</td>
              </tr>
              <tr>
                <td>BDF generado</td>
                <td class="mono">{{ run.generated_bdf }}</td>
              </tr>
              <tr>
                <td>F06 frecuencias ref</td>
                <td class="mono">{{ run.reference_frequencies_f06 }}</td>
              </tr>
              <tr>
                <td>F06 autovectores ref</td>
                <td class="mono">{{ run.reference_vectors_f06 }}</td>
              </tr>
              <tr>
                <td>Snapshot config</td>
                <td class="mono">{{ run.config_snapshot_dir }}</td>
              </tr>
            </tbody>
          </table>
        </article>
      </section>
    </main>
  </body>
</html>
